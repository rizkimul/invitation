# Backend opsional untuk RSVP & Buku Ucapan.
# Kosongkan keduanya bila ingin mode demo (data tersimpan di localStorage peramban).
#
# Ambil dari Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Alamat kanonik undangan, dipakai untuk og:url & og:image (preview WhatsApp).
# Di Vercel boleh dikosongkan — diisi otomatis dari VERCEL_PROJECT_PRODUCTION_URL.
# Isi manual begitu memakai domain sendiri. Tanpa garis miring di akhir.
VITE_SITE_URL=
